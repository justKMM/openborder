# Copy to `.env` (which is gitignored) and fill in. docker compose reads it automatically.

# Dash0 -> Settings -> Organization -> Endpoints: copy the OTLP/gRPC endpoint, including the port.
# It is a different host from DASH0_API_URL (the REST API that `openborder apply` uses).
DASH0_OTLP_ENDPOINT=ingress.<your-region>.dash0.com:4317

# Dash0 -> Settings -> Auth Tokens. Use the same token OpenBorder uses, or a separate one that may ingest data.
DASH0_AUTH_TOKEN=

# The dataset your migrated dashboard and rules were imported into.
DASH0_DATASET=default

# Becomes the host.name resource attribute, i.e. the `host_name` label the dashboard's $host variable lists.
DEMO_HOST_NAME=redis-demo
