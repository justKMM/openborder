    "panels": {
      "panel-01": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Note"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This dashboard shows latency information and slow query counts that summarize your Redis master's performance, as well as memory metrics to help you manage your Redis instance.\n\n##### [Official Datadog Redis documentation ↗](https://docs.datadoghq.com/integrations/redisdb/)"
            }
          }
        }
      },
      "panel-02": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Note"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "**Our 3-part blog series**\n\n\n[How to monitor Redis performance metrics&nbsp;↗](https://www.datadoghq.com/blog/how-to-monitor-redis-performance-metrics/)\n\n[Collecting Redis metrics&nbsp;↗](https://www.datadoghq.com/blog/how-to-collect-redis-metrics/)\n\n[Monitoring Redis with Datadog&nbsp;↗](https://www.datadoghq.com/blog/monitor-redis-using-datadog/)"
            }
          }
        }
      },
      "panel-03": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "≈ Datadog's agent reports a per-second rate computed between check runs; PromQL rate() over the window is the same quantity but is smoothed over a different window\n≈ Datadog's agent reports a per-second rate computed between check runs; PromQL rate() over the window is the same quantity but is smoothed over a different window\n≈ not migrated: conditional colour formats\n~ Datadog aggregates each query over the time range first and then evaluates the formula (a ratio of averages); the migrated panel evaluates the formula at every step and then averages (an average of ratios), so the value can differ slightly\nDatadog query: avg:redis.stats.keyspace_hits{$scope,$host}\nDatadog query: avg:redis.stats.keyspace_misses{$scope,$host}\nDatadog query: (query1 / (query1 + query2)) * 100",
            "name": "Hit rate"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean",
              "format": {
                "decimalPlaces": 0,
                "unit": "percent"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg(rate({otel_metric_name=\"redis.keyspace.hits\", host_name=~\"^($host)$\"}[$__rate_interval])) / (avg(rate({otel_metric_name=\"redis.keyspace.hits\", host_name=~\"^($host)$\"}[$__rate_interval])) + avg(rate({otel_metric_name=\"redis.keyspace.misses\", host_name=~\"^($host)$\"}[$__rate_interval]))) * 100"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-04": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "≈ not migrated: conditional colour formats\n≈ Datadog aggregates over the time range; the migrated panel applies the same calculation to the returned series, so sampling can differ slightly\nDatadog query: sum:redis.clients.blocked{$scope,$host}",
            "name": "Blocked clients"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "max",
              "format": {
                "decimalPlaces": 0,
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum({otel_metric_name=\"redis.clients.blocked\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-05": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "≈ not migrated: conditional colour formats\n≈ Datadog aggregates over the time range; the migrated panel applies the same calculation to the returned series, so sampling can differ slightly\nDatadog query: sum:redis.keys{$scope,$host}",
            "name": "Redis keyspace"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "max",
              "format": {
                "decimalPlaces": 2,
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum({otel_metric_name=\"redis.db.keys\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-06": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "≈ not migrated: conditional colour formats\n≈ Datadog aggregates over the time range; the migrated panel applies the same calculation to the returned series, so sampling can differ slightly\nDatadog query: sum:redis.rdb.changes_since_last{$scope,$host}",
            "name": "Unsaved changes"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean",
              "format": {
                "decimalPlaces": 2,
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum({otel_metric_name=\"redis.rdb.changes_since_last_save\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-07": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "~ 'redis.replication.master_link_down_since_seconds' has no known OpenTelemetry equivalent; it is queried under its Datadog name and will probably show no data until it is mapped\n≈ not migrated: conditional colour formats\n≈ Datadog aggregates over the time range; the migrated panel applies the same calculation to the returned series, so sampling can differ slightly\nDatadog query: sum:redis.replication.master_link_down_since_seconds{$scope,$host}",
            "name": "Primary link down"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean",
              "format": {
                "decimalPlaces": 0,
                "unit": "seconds"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum({otel_metric_name=\"redis.replication.master_link_down_since_seconds\", host_name=~\"^($host)$\"})"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-08": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Note"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "This metric is only available when the connection between the primary and its replica has been lost. Ideally, this value should never exceed zero—the primary and the replica should be in constant communication to ensure the replica is not serving stale data."
            }
          }
        }
      },
      "panel-09": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "~ 'redis.info.latency_ms' has no known OpenTelemetry equivalent; it is queried under its Datadog name and will probably show no data until it is mapped\nDatadog query: avg:redis.info.latency_ms{$scope,$host} by {host}",
            "name": "Latency by Host"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "showLegend": true
              },
              "visual": {
                "display": "line"
              },
              "yAxis": {
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg by (host_name) ({otel_metric_name=\"redis.info.latency_ms\", host_name=~\"^($host)$\"})",
                    "seriesNameFormat": "{{host_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Note"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Latency measures the **time between a client request and the server response**, and monitoring it enables you to detect changes in Redis performance. The single-threaded nature of Redis means that a long response time for one request increases the latency for all subsequent requests, leading to serious bottlenecks."
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "~ 'redis.slowlog.micros.95percentile' has no known OpenTelemetry equivalent; it is queried under its Datadog name and will probably show no data until it is mapped\n~ tag 'name' has no mapping; it is used as label 'name', which may not exist on the OpenTelemetry series\n~ tag 'command' has no mapping; it is used as label 'command', which may not exist on the OpenTelemetry series\n~ Datadog picks the top series once over the whole time range; PromQL re-ranks at every step over a trailing window, so the set of series shown can differ\nDatadog query: sum:redis.slowlog.micros.95percentile{$scope,$host} by {name,command}\nDatadog query: top(query1 / 1000, 10, 'mean', 'desc')",
            "name": "Slowlog duration"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "showLegend": true
              },
              "visual": {
                "areaOpacity": 0.55,
                "display": "line"
              },
              "yAxis": {
                "format": {
                  "unit": "milliseconds"
                },
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "topk(10, avg_over_time((sum by (name, command) ({otel_metric_name=\"redis.slowlog.micros.95percentile\", host_name=~\"^($host)$\"}) / 1000)[$__range:]))"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-12": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Slowlog query rates"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "**Not migrated: Slowlog query rates**\n\nDatadog widget type `toplist`. Dash0 has no ranked bar/table panel we can target yet; recreate it as a table or bar chart\n\nOriginal query:\n- `sum:redis.slowlog.micros.count{$host,$scope} by {command,name}`\n\nThe full original definition is kept in `plan.json`."
            }
          }
        }
      },
      "panel-13": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "~ 'redis.replication.delay' has no known OpenTelemetry equivalent; it is queried under its Datadog name and will probably show no data until it is mapped\nDatadog query: avg:redis.replication.delay{$host,$scope}",
            "name": "Average replication delay (offset)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "showLegend": false
              },
              "visual": {
                "display": "line"
              },
              "yAxis": {
                "min": 0
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg({otel_metric_name=\"redis.replication.delay\", host_name=~\"^($host)$\"})",
                    "seriesNameFormat": "Offsets"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-14": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "≈ Datadog's agent reports a per-second rate computed between check runs; PromQL rate() over the window is the same quantity but is smoothed over a different window\n≈ Datadog's agent reports a per-second rate computed between check runs; PromQL rate() over the window is the same quantity but is smoothed over a different window\nDatadog query: avg:redis.cpu.sys{$host,$scope}\nDatadog query: avg:redis.cpu.user{$host,$scope}",
            "name": "Average CPU usage"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "showLegend": true
              },
              "visual": {
                "display": "line"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg(rate({otel_metric_name=\"redis.cpu.time\", state=\"sys\", host_name=~\"^($host)$\"}[$__rate_interval]))",
                    "seriesNameFormat": "System"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg(rate({otel_metric_name=\"redis.cpu.time\", state=\"user\", host_name=~\"^($host)$\"}[$__rate_interval]))",
                    "seriesNameFormat": "User"
                  }
                }
              }
            }
          ]
        }
      },
      "panel-15": {
        "kind": "Panel",
        "spec": {
          "display": {
            "description": "≈ Datadog's agent reports a per-second rate computed between check runs; PromQL rate() over the window is the same quantity but is smoothed over a different window\n≈ Datadog's agent reports a per-second rate computed between check runs; PromQL rate() over the window is the same quantity but is smoothed over a different window\n≈ not migrated: conditional colour formats\n~ Datadog aggregates each query over the time range first and then evaluates the formula (a ratio of averages); the migrated panel evaluates the formula at every step and then averages (an average of ratios), so the value can differ slightly\nDatadog query: avg:redis.stats.keyspace_hits{$scope,$host}\nDatadog query: avg:redis.stats.keyspace_misses{$scope,$host}\nDatadog query: (query1 / (query1 + query2)) * 100",
            "name": "Cache hit rate"
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "mean",
              "format": {
                "decimalPlaces": 2,
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "avg(rate({otel_metric_name=\"redis.keyspace.hits\", host_name=~\"^($host)$\"}[$__rate_interval])) / (avg(rate({otel_metric_name=\"redis.keyspace.hits\", host_name=~\"^($host)$\"}[$__rate_interval])) + avg(rate({otel_metric_name=\"redis.keyspace.misses\", host_name=~\"^($host)$\"}[$__rate_interval]))) * 100"
