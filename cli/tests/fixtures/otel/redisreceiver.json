      },
      "type": "Gauge"
    },
    "redis.db.expires": {
      "attributes": {
        "db": [
          "0"
        ]
      },
      "type": "Gauge"
    },
    "redis.db.keys": {
      "attributes": {
        "db": [
          "0"
        ]
      },
      "type": "Gauge"
    },
    "redis.keys.evicted": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.keys.expired": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.keyspace.hits": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.keyspace.misses": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.latest_fork": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.maxmemory": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.memory.fragmentation_ratio": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.memory.lua": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.memory.peak": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.memory.rss": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.memory.used": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.net.input": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.net.output": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.rdb.changes_since_last_save": {
