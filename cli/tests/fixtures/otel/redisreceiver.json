{
  "collector": "otelcol-contrib 0.165.0",
  "metrics": {
    "redis.clients.blocked": {
      "attributes": {},
      "monotonic": false,
      "type": "Sum"
    },
    "redis.clients.connected": {
      "attributes": {},
      "monotonic": false,
      "type": "Sum"
    },
    "redis.clients.max_input_buffer": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.clients.max_output_buffer": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.commands": {
      "attributes": {},
      "type": "Gauge"
    },
    "redis.commands.processed": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.connections.received": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.connections.rejected": {
      "attributes": {},
      "monotonic": true,
      "type": "Sum"
    },
    "redis.cpu.time": {
      "attributes": {
        "state": [
          "sys",
          "sys_children",
          "sys_main_thread",
          "user",
          "user_children",
          "user_main_thread"
